# MSG91 (https://control.msg91.com) — required for /api/send-otp and /api/verify-otp
MSG91_AUTHKEY=
# Template must be an MSG91 OTP template configured on the WhatsApp channel
MSG91_WHATSAPP_TEMPLATE_ID=

# Optional: secret used to sign the short-lived verification token returned by
# /api/verify-otp. Falls back to MSG91_AUTHKEY if unset, but a dedicated
# secret is recommended so rotating the MSG91 key doesn't invalidate sessions.
SESSION_SECRET=

# Cashfree Verification Suite (https://www.cashfree.com/docs/api-reference/vrs/v2/gstin/verify-gstin)
# — required for /api/verify-gstin
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# "sandbox" or leave unset/"production" for the live endpoint
CASHFREE_ENV=

# Supabase (https://app.supabase.com) — required for /api/submit-registration.
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level
# Security — it must only ever be set here (server-side env vars), never in
# client-side code or a NEXT_PUBLIC_/VITE_-style public variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
