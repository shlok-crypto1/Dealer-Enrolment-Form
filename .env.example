# MSG91 (https://control.msg91.com) — required for /api/send-otp and /api/verify-otp
MSG91_AUTHKEY=
# Template must be an MSG91 OTP template configured on the WhatsApp channel
MSG91_WHATSAPP_TEMPLATE_ID=

# Optional: secret used to sign the short-lived verification token returned by
# /api/verify-otp. Falls back to MSG91_AUTHKEY if unset, but a dedicated
# secret is recommended so rotating the MSG91 key doesn't invalidate sessions.
SESSION_SECRET=
